  <style type="text/css" data-vite-dev-id="/home/geni/Documents/vale-village-v2/src/ui/components/TitleScreen.css">.title-screen {
  position: fixed;
  inset: 0;
  /* Ensure full viewport size for reliable e2e visibility checks */
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 18% 18%, rgba(255, 216, 127, 0.08), transparent 32%),
    radial-gradient(circle at 82% 12%, rgba(116, 186, 255, 0.08), transparent 30%),
    radial-gradient(circle at 30% 78%, rgba(255, 144, 104, 0.05), transparent 34%),
    linear-gradient(180deg, #080b14 0%, #0c1223 45%, #05070d 100%);
  color: #f6e9d7;
  cursor: pointer;
  overflow: hidden;
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
}

.title-screen::before {
  content: '';
  position: absolute;
  inset: -18%;
  background:
    radial-gradient(circle at 35% 40%, rgba(104, 186, 255, 0.14), transparent 42%),
    radial-gradient(circle at 70% 75%, rgba(255, 216, 127, 0.12), transparent 40%);
  filter: blur(18px);
  opacity: 0.85;
  animation: menuAurora 18s ease-in-out infinite alternate;
  pointer-events: none;
  z-index: 0;
}

.title-screen::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(1px 1px at 20% 30%, rgba(255, 255, 255, 0.7), transparent),
    radial-gradient(1px 1px at 55% 80%, rgba(255, 255, 255, 0.6), transparent),
    radial-gradient(1px 1px at 80% 25%, rgba(255, 255, 255, 0.55), transparent),
    radial-gradient(1px 1px at 40% 65%, rgba(255, 255, 255, 0.45), transparent);
  opacity: 0.4;
  animation: starField 26s linear infinite;
  pointer-events: none;
  z-index: 0;
}

.title-screen-content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 3rem 3.25rem;
  border-radius: 20px;
  background: linear-gradient(145deg, rgba(22, 25, 36, 0.94), rgba(12, 14, 24, 0.96));
  border: 1px solid rgba(255, 216, 127, 0.28);
  box-shadow:
    0 26px 60px rgba(0, 0, 0, 0.55),
    inset 0 0 0 1px rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(6px);
}

.title-screen-content::before {
  content: '';
  position: absolute;
  inset: 1px;
  border-radius: 18px;
  border: 1px solid rgba(255, 255, 255, 0.05);
  pointer-events: none;
}

.title-screen-logo {
  font-size: 4.2rem;
  font-weight: 800;
  letter-spacing: 0.2em;
  margin: 0 0 1.2rem 0;
  display: inline-block;
  padding: 0.9rem 1.5rem;
  border-radius: 18px;
  text-transform: uppercase;
  background: linear-gradient(125deg, #f9e4b2 0%, #f2c572 45%, #ffe7a4 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-shadow:
    0 10px 25px rgba(0, 0, 0, 0.55),
    0 0 30px rgba(249, 214, 127, 0.25);
  box-shadow:
    0 0 0 2px rgba(255, 216, 127, 0.45),
    0 0 26px rgba(255, 216, 127, 0.32),
    0 0 54px rgba(242, 197, 114, 0.28);
}

.title-screen-subtitle {
  margin: 0;
  font-size: 1.05rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #c0c8de;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.55);
  animation: subtitlePulse 2s ease-in-out infinite alternate;
}

@keyframes menuAurora {
  0% {
    transform: translate3d(-12px, -8px, 0) scale(1);
  }
  100% {
    transform: translate3d(14px, 10px, 0) scale(1.05);
  }
}

@keyframes starField {
  0% {
    background-position: 0 0;
  }
  100% {
    background-position: -220px 220px;
  }
}

@keyframes subtitlePulse {
  0% {
    opacity: 0.85;
    transform: translateY(0);
  }
  100% {
    opacity: 1;
    transform: translateY(-2px);
  }
}

/* Character parade at bottom of title screen */
.title-screen-parade {
  position: absolute;
  bottom: 60px;
  left: 0;
  right: 0;
  height: 64px;
  overflow: hidden;
  z-index: 2;
}

.title-screen-character {
  position: absolute;
  bottom: 0;
  animation: characterWalk 12s linear infinite;
  opacity: 0;
}

.title-screen-sprite {
  width: 48px;
  height: 48px;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.5));
}

@keyframes characterWalk {
  0% {
    left: -60px;
    opacity: 0;
  }
  5% {
    opacity: 1;
  }
  95% {
    opacity: 1;
  }
  100% {
    left: calc(100% + 60px);
    opacity: 0;
  }
}
</style><style type="text/css" data-vite-dev-id="/home/geni/Documents/vale-village-v2/src/ui/components/overworld/OverworldCanvas.css">/**
 * OverworldCanvas Styles
 * Container, canvas styling, and UI chrome for the pseudo-3D overworld
 */

/* Shell container - from OverworldMap.css */
.overworld-shell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.75rem 1.25rem;
  background: #03080c;
  min-height: 100vh;
}

/* Location banner fade animation */
@keyframes bannerFadeInOut {
  0% { opacity: 0; transform: translateY(-10px); }
  15% { opacity: 1; transform: translateY(0); }
  85% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-10px); }
}

/* Location banner */
.location-banner {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  background: rgba(5, 12, 17, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  border-radius: 999px;
  padding: 0.4rem 0.75rem;
  color: #e7f4f1;
  backdrop-filter: blur(8px);
  animation: bannerFadeInOut 4s ease-in-out forwards;
}

.location-title {
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 700;
  font-size: 0.95rem;
}

.location-meta {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  flex-wrap: wrap;
}

.location-chip {
  padding: 0.2rem 0.55rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 0.85rem;
  color: #d9e8e5;
}

.location-chip--ghost {
  background: transparent;
  border-color: rgba(255, 255, 255, 0.15);
  color: rgba(233, 244, 241, 0.8);
}

/* Overworld stage container */
.overworld-stage {
  background:
    radial-gradient(circle at 30% 30%, rgba(79, 149, 255, 0.1), transparent 45%),
    radial-gradient(circle at 70% 70%, rgba(255, 199, 94, 0.08), transparent 40%),
    #03080c;
  padding: 0.85rem;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.45);
}

/* Canvas container */
.overworld-canvas-container {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #1a1a2a;
  overflow: hidden;
  border-radius: 8px;
}

.overworld-canvas {
  /* Pixel-perfect rendering */
  image-rendering: pixelated;
  image-rendering: crisp-edges;

  /* Prevent blurry scaling */
  -ms-interpolation-mode: nearest-neighbor;

  /* Center and scale to fit container */
  max-width: 100%;
  max-height: 100%;

  /* Subtle shadow for depth */
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);

  /* Smooth border radius for polish */
  border-radius: 4px;
}

/* Sprite overlay for animated GIF sprites (Phase 3) */
.sprite-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
}

.sprite-overlay img {
  position: absolute;
  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

/* Loading state */
.overworld-canvas-container.loading::after {
  content: 'Loading...';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-family: monospace;
  font-size: 16px;
  animation: pulse 1s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* Debug overlay styling */
.overworld-canvas-container.debug .overworld-canvas {
  outline: 2px solid #ff0;
}

/* Focus state for accessibility */
.overworld-canvas:focus {
  outline: 2px solid #5090d8;
  outline-offset: 2px;
}

/* Responsive scaling */
@media (max-width: 1024px) {
  .overworld-canvas {
    width: 100%;
    height: auto;
  }
}

/* Mobile touch area hint */
@media (max-width: 768px) {
  .overworld-canvas-container::before {
    content: '';
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 120px;
    border: 2px dashed rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    pointer-events: none;
  }
}
</style><style type="text/css" data-vite-dev-id="/home/geni/Documents/vale-village-v2/src/ui/components/VirtualJoystick.css">.virtual-controls {
